# ======================
# Plaid Finance Agent
# ======================

# Plaid API — https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox

# Security — generate with: npm run generate-keys
ENCRYPTION_KEY=
BEARER_TOKEN=

# Server
PORT=3100
HOST=127.0.0.1

# Logging
LOG_LEVEL=info

# Optional: Plaid webhooks (requires public URL)
# Use Tailscale Funnel or leave blank for poll-only mode
WEBHOOK_URL=

# Optional: Telegram alerts via OpenClaw
# OPENCLAW_WEBHOOK_URL=http://localhost:3000/api/notify
